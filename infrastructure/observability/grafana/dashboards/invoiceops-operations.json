    {"id": 4, "title": "OCR, VLM and grounding", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (outcome) (rate(invoiceops_ocr_total[5m]))", "legendFormat": "OCR {{outcome}}"}, {"expr": "sum by (provider, outcome) (rate(invoiceops_vlm_calls_total[5m]))", "legendFormat": "VLM {{provider}} {{outcome}}"}, {"expr": "sum by (outcome) (rate(invoiceops_grounding_total[5m]))", "legendFormat": "grounding {{outcome}}"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}},

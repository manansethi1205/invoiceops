    {"id": 1, "title": "Ingestion outcomes", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (outcome) (rate(invoiceops_ingestion_total[5m]))", "legendFormat": "{{outcome}}"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}},

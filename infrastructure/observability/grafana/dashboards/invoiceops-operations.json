    {"id": 6, "title": "Review backlog", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(invoiceops_review_open_cases)", "legendFormat": "open"}, {"expr": "max(invoiceops_review_oldest_case_age_seconds)", "legendFormat": "oldest seconds"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}},

ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://invoiceops:invoiceops@postgres:5432/invoiceops
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=invoiceops
S3_SECRET_ACCESS_KEY=change-me-in-real-deployments
S3_BUCKET=invoice-documents
S3_REGION=us-east-1
MAX_UPLOAD_BYTES=15728640

# Disabled and model-less by default: no provider spend is possible without explicit opt-in.
VLM_ENABLED=false
VLM_PROVIDER=openai
VLM_MODEL=
VLM_PROMPT_VERSION=invoice-vision-v1
VLM_TIMEOUT_SECONDS=45
VLM_MAX_RETRIES=2
VLM_MAX_PAGES=5
VLM_RENDER_DPI=150
VLM_MAX_IMAGE_DIMENSION=2048
VLM_IMAGE_DETAIL=auto
VLM_FUZZY_GROUNDING_THRESHOLD=92
OPENAI_API_KEY=
